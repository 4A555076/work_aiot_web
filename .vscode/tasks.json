{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run-client-dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "ready",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "run-server",
      "type": "shell",
      "command": "node index.js",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "start-all",
      "dependsOn": [
        "run-server",
        "run-client-dev"
      ],
      "dependsOrder": "parallel"
    }
  ]
}